# Copy to .env on the server; use unique secrets and keep .env out of Git.
# Generate secrets with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace_with_64_random_hex_characters
POSTGRES_PASSWORD=replace_with_a_unique_strong_password

# Hosted OpenAI-compatible provider. Ollama is available only with --profile local-llm.
OPENAI_API_KEY=replace_with_provider_key
OPENAI_MODEL=replace_with_supported_model
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
MAX_SEARCH_RESULTS=5

# Local browser URLs. Production provider settings are in DEPLOYMENT.md.
FRONTEND_PORT=8080
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:8080/
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_PROXY_HOPS=0
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Asia/Kolkata
EXECUTIONS_DATA_MAX_AGE=336

# Optional for the local Caddy edge profile.
TLS_HOSTNAME=alerts.example.com

# Optional: the bot must be admin of a dedicated test channel before configuration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
N8N_API_KEY=
